#!/usr/bin/env bash
#
# check-tls13-handshake.sh
# ------------------------------------------------------------------------------
# Verifies the key exchange group (KEX), the signature algorithm, and the cipher
# suite (AEAD encryption + hash) negotiated in the TLS 1.3 handshake, across
# several PQC/classical scenarios, each listening on its own port.
#
# On each port only the expected KEX group is offered and a single cipher suite
# is forced: if the server does not support them, the handshake fails (strict
# check).
#
# Requirements: OpenSSL 3.5+ (RHEL 10.2) for the PQC groups/algorithms.
# Note: verifying SLH-DSA signatures in TLS depends on draft support in the
#       client (openssl s_client from 3.5 should; browsers not yet).
# ------------------------------------------------------------------------------
set -u

# --- Configuration ------------------------------------------------------------
# The endpoint is a variable; it can be overridden as the first argument.
ENDPOINT="${1:-{{webserver}}}"
CONNECT_TIMEOUT=5          # max seconds per connection attempt

# Optional SNI: if your vhosts select the certificate by name, set it here.
# Leave empty to connect by IP only.
SERVERNAME=""

# Fixed TLS 1.3 cipher suite for ALL tests. In TLS 1.3 the suite binds both the
# AEAD encryption and the hash used by the key schedule/transcript/Finished, so
# fixing the suite fixes both. It is forced on the client and verified against
# the actually negotiated suite.
CIPHERSUITE="{{tls_cipher}}"
# Expected values derived from the suite (only to display/verify separately):
EXPECTED_AEAD="{{aead}}"   # authenticated encryption
EXPECTED_HASH="{{hash}}"        # hash for HKDF/transcript/Finished

# Scenarios:  port | KEX_group(openssl name) | sig_needle | description
#   - KEX_group  : group name as understood by OpenSSL 3.5
#   - sig_needle : string that must appear in the certificate's signature/key
#                  algorithm (literal, case-insensitive match)
SCENARIOS=(
  "1443|MLKEM768|ML-DSA-65|ML-KEM-768 + ML-DSA-65"
  "2553|secp384r1|ecdsa-with-SHA384|NIST P-384 + ECDSA-SHA384"
  "2443|MLKEM768|SLH-DSA-SHA2-192s|ML-KEM-768 + SLH-DSA-SHA2-192s"
  "3443|MLKEM1024|ML-DSA-87|ML-KEM-1024 + ML-DSA-87"
  "3553|secp521r1|ecdsa-with-SHA512|NIST P-521 + ECDSA-SHA512"
)

# --- Colors (disabled without a TTY or with NO_COLOR) -------------------------
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  G=$'\e[32m'; R=$'\e[31m'; B=$'\e[1m'; N=$'\e[0m'
else
  G=""; R=""; B=""; N=""
fi

command -v openssl >/dev/null 2>&1 || { echo "openssl not found in PATH"; exit 2; }

printf '%s\n\n' "${B}TLS 1.3 handshake verification against ${ENDPOINT}${N}"

pass=0; fail=0

for entry in "${SCENARIOS[@]}"; do
  IFS='|' read -r PORT GROUP SIG_NEEDLE DESC <<< "$entry"

  printf '%s\n' "${B}=== ${DESC}  (${ENDPOINT}:${PORT}) ===${N}"

  # SNI arguments only if SERVERNAME is set
  sni_args=()
  [[ -n "$SERVERNAME" ]] && sni_args=(-servername "$SERVERNAME")

  # TLS 1.3 handshake offering only the expected group and the fixed suite
  out=$(timeout "$CONNECT_TIMEOUT" openssl s_client \
          -connect "${ENDPOINT}:${PORT}" \
          -tls1_3 -groups "$GROUP" -ciphersuites "$CIPHERSUITE" \
          "${sni_args[@]}" </dev/null 2>/dev/null)

  if [[ -z "$out" ]] || ! grep -qi "BEGIN CERTIFICATE" <<< "$out"; then
    printf '  %sERROR%s  no response or failed handshake (group %s not supported?)\n\n' \
           "$R" "$N" "$GROUP"
    fail=$((fail+1))
    continue
  fi

  # Handshake data
  proto=$(grep -iE '^\s*Protocol\s*:' <<< "$out" | head -1 | sed 's/.*: *//')
  neg_group=$(grep -i 'Negotiated TLS1.3 group' <<< "$out" | head -1 | sed 's/.*group: *//')
  # Fallback: classical curves are often reported as "Server Temp Key: ECDH, P-384, 384 bits"
  if [[ -z "$neg_group" ]]; then
    neg_group=$(grep -i 'Server Temp Key' <<< "$out" | head -1 \
                | sed -E 's/.*Server Temp Key: *//; s/^[A-Za-z0-9]+, *//; s/,.*//')
  fi
  peer_type=$(grep -i 'Peer signature type' <<< "$out" | head -1 | sed 's/.*type: *//')
  peer_dig=$(grep -i 'Peer signing digest'  <<< "$out" | head -1 | sed 's/.*digest: *//')

  # Negotiated cipher suite (line "Cipher    : TLS_AES_256_GCM_SHA384")
  neg_suite=$(grep -iE '^\s*Cipher\s*:' <<< "$out" | head -1 | sed 's/.*: *//')
  # Fallback: line "New, TLSv1.3, Cipher is TLS_AES_256_GCM_SHA384"
  [[ -z "$neg_suite" || "$neg_suite" == "(NONE)" ]] && \
    neg_suite=$(grep -i 'Cipher is' <<< "$out" | head -1 | sed 's/.*Cipher is *//')

  # Leaf certificate (without -showcerts, s_client prints only the server's)
  pem=$(sed -n '/-----BEGIN CERTIFICATE-----/,/-----END CERTIFICATE-----/p' <<< "$out")
  certtext=$(openssl x509 -noout -text 2>/dev/null <<< "$pem")
  pubalg=$(grep -i  'Public Key Algorithm' <<< "$certtext" | head -1 | sed 's/.*Algorithm: *//')
  sigalg=$(grep -iE 'Signature Algorithm'  <<< "$certtext" | head -1 | sed 's/.*Algorithm: *//')

  # --- Checks ---
  # 1) TLS 1.3 protocol
  [[ "$proto" == "TLSv1.3" ]] && tls_ok=1 || tls_ok=0
  # 2) Negotiated KEX. Only "$GROUP" was offered, so a valid TLS 1.3 handshake
  #    already implies that group was used. If openssl also reports the group,
  #    it is compared (normalizing curve aliases); if it does not report it,
  #    a successful handshake is enough.
  normalize() {
    case "${1,,}" in
      secp384r1|p-384) echo "p-384" ;;
      secp521r1|p-521) echo "p-521" ;;
      secp256r1|p-256|prime256v1) echo "p-256" ;;
      *) echo "${1,,}" ;;
    esac
  }
  if [[ -n "$neg_group" ]]; then
    [[ "$(normalize "$neg_group")" == "$(normalize "$GROUP")" ]] && kex_ok=1 || kex_ok=0
    neg_show="$neg_group"
  else
    # openssl did not report the group (common for classical curves depending on
    # the build): a TLS 1.3 handshake with a single forced group is the proof.
    kex_ok=$tls_ok
    neg_show="$GROUP (forced; handshake OK)"
  fi
  # 3) The expected signature appears in the certificate (key or signature)
  grep -qiF "$SIG_NEEDLE" <<< "$certtext" && sig_ok=1 || sig_ok=0
  # 4) Negotiated cipher suite == fixed suite (verifies AEAD AND hash at once)
  [[ "$neg_suite" == "$CIPHERSUITE" ]] && suite_ok=1 || suite_ok=0

  mark() { [[ "$1" == 1 ]] && printf '%sOK%s'   "$G" "$N" || printf '%sFAIL%s' "$R" "$N"; }

  printf '  Protocol           : %-10s [%s]\n' "${proto:-?}"     "$(mark "$tls_ok")"
  printf '  KEX expected       : %s\n'                            "$GROUP"
  printf '  KEX negotiated     : %-10s [%s]\n' "${neg_show:-?}" "$(mark "$kex_ok")"
  printf '  Signature expected : %s\n'                            "$SIG_NEEDLE"
  printf '  Cert Public Key    : %s\n'                            "${pubalg:-?}"
  printf '  Cert Signature     : %-18s [%s]\n' "${sigalg:-?}"    "$(mark "$sig_ok")"
  # ML-DSA/SLH-DSA embed the hash in the scheme itself: no external digest
  dig_show="${peer_dig:-n/a (hash embedded)}"
  [[ -n "$peer_type" ]] && printf '  CertVerify (online): %s / %s\n' "${peer_type}" "$dig_show"
  # Negotiated cipher suite -> AEAD encryption and hash are fixed by the suite
  printf '  Suite expected     : %s\n'                            "$CIPHERSUITE"
  printf '  Suite negotiated   : %-22s [%s]\n' "${neg_suite:-?}" "$(mark "$suite_ok")"
  printf '    -> Cipher (AEAD) : %-22s [%s]\n' "$EXPECTED_AEAD"  "$(mark "$suite_ok")"
  printf '    -> Hash          : %-22s [%s]\n' "$EXPECTED_HASH"  "$(mark "$suite_ok")"

  if [[ "$tls_ok" == 1 && "$kex_ok" == 1 && "$sig_ok" == 1 && "$suite_ok" == 1 ]]; then
    printf '  %sRESULT: PASS%s\n\n' "$G" "$N"; pass=$((pass+1))
  else
    printf '  %sRESULT: FAIL%s\n\n' "$R" "$N"; fail=$((fail+1))
  fi
done

printf '%s\n' "${B}Summary: ${pass} PASS, ${fail} FAIL${N}"
[[ "$fail" -eq 0 ]]