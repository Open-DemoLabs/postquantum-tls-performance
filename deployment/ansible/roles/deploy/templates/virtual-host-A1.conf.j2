# /etc/httpd/conf.d/virtual-host-A1.conf
# A1 - PQC Enterprise: KEX: X25519MLKEM768, DIGITAL SIGNATURE: ML-DSA-65
# Only TLS 1.3, only X25519MLKEM768 (hybrid)

Listen 10443 https

<VirtualHost *:10443>
    ServerName {{ webserver }}

    DocumentRoot /var/www/a1
    LogFormat "%h %t \"%r\" %>s %b %D %{SSL_PROTOCOL}x %{SSL_CIPHER}x %{SSL_GROUP}x %{SSL_SERVER_A_SIG}x" pqc
    ErrorLog  /var/log/httpd/a1_error.log
    CustomLog /var/log/httpd/a1_access.log pqc

    SSLEngine on

    # TLS 1.3
    SSLProtocol -all +TLSv1.3

    # KEX: X25519MLKEM768 (hybrid), DIGITALSIGNATURE: ML-DSA-65
    SSLOpenSSLConfCmd Groups X25519MLKEM768
    # Ciphersuite
    SSLOpenSSLConfCmd Ciphersuites {{ tls_cipher }}

    # Cert chain
    SSLCertificateChainFile    /etc/pki/regular-A1-CA/certs/regular-A1.chain.pem

    # Cert
    SSLCertificateKeyFile /etc/pki/regular-A1-CA/private/virtualhost.key.pem
    SSLCertificateFile    /etc/pki/regular-A1-CA/certs/virtualhost.cert.pem

    <Directory /var/www/a1>
        Require all granted
    </Directory>
</VirtualHost>