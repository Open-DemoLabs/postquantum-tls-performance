# SPDX-License-Identifier: GPL-3.0-or-later
# =============================================================================
# wrk HTTP benchmarking tool compiled against the distribution OpenSSL (>= 3.5)
# on CentOS Stream 9, for TLS 1.3 post-quantum (ML-KEM / ML-DSA) benchmarks.
#
# Multi-stage build:
#   1. builder : installs the toolchain + openssl-devel, clones and compiles wrk
#                with "make WITH_OPENSSL=/usr", and stages the result in /staging
#   2. runtime : minimal CentOS Stream 9 image with only the OpenSSL runtime,
#                the wrk binary, the scripts in /srv/scripts (WORKDIR) and
#                the /srv/data mount point for user-provided custom scripts
#
# Build:  podman build -t localhost/wrk-pqc:latest -f Containerfile .
#         buildah build -t localhost/wrk-pqc:latest -f Containerfile .
# =============================================================================

ARG BUILDER_IMAGE=quay.io/centos/centos:stream9
ARG RUNTIME_IMAGE=quay.io/centos/centos:stream9-minimal

# -----------------------------------------------------------------------------
# Stage 1: builder
# -----------------------------------------------------------------------------
FROM ${BUILDER_IMAGE} AS builder

ARG WRK_REPO=https://github.com/wg/wrk.git
ARG WRK_REF=master
ARG MIN_OPENSSL_VERSION=3.5.0
ARG LICENSE_URL=https://www.gnu.org/licenses/gpl-3.0.txt

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN dnf -y install --setopt=install_weak_deps=False --setopt=tsflags=nodocs \
        gcc make git tar gzip unzip findutils which curl-minimal \
        openssl openssl-libs openssl-devel \
 && dnf clean all \
 && rm -rf /var/cache/dnf

# Fail early if the distribution OpenSSL is too old or lacks PQC algorithms.
RUN v="$(rpm -q --qf '%{VERSION}' openssl-libs)"; \
    echo "Builder openssl-libs version: ${v}"; \
    if [ "$(printf '%s\n%s\n' "${MIN_OPENSSL_VERSION}" "${v}" | sort -V | head -n1)" != "${MIN_OPENSSL_VERSION}" ]; then \
        echo "ERROR: OpenSSL ${v} is older than the required ${MIN_OPENSSL_VERSION}" >&2; exit 1; \
    fi; \
    openssl list -kem-algorithms       | grep -qi 'ML-KEM' || { echo "ERROR: ML-KEM not available" >&2; exit 1; }; \
    openssl list -signature-algorithms | grep -qi 'ML-DSA' || { echo "ERROR: ML-DSA not available" >&2; exit 1; }

WORKDIR /src
RUN git clone --depth 1 --branch "${WRK_REF}" "${WRK_REPO}" wrk

WORKDIR /src/wrk
# Link against the system OpenSSL (/usr/include, /usr/lib64) instead of the
# OpenSSL tarball bundled with wrk. LuaJIT is still built from wrk's deps/.
RUN make WITH_OPENSSL=/usr -j"$(nproc)"

# Verify the binary is dynamically linked to the system libssl/libcrypto 3.
RUN ldd ./wrk; \
    ldd ./wrk | grep -Eq 'libssl\.so\.3 => /(usr/)?lib64/libssl\.so\.3'       || { echo "ERROR: wrk not linked to system libssl"    >&2; exit 1; }; \
    ldd ./wrk | grep -Eq 'libcrypto\.so\.3 => /(usr/)?lib64/libcrypto\.so\.3' || { echo "ERROR: wrk not linked to system libcrypto" >&2; exit 1; }

# Download the GPL-3.0 license text for this image (GPL-3.0-or-later) and make
# sure it really is the GPLv3 and not an error page.
RUN curl -fsSL --retry 3 -o /tmp/LICENSE "${LICENSE_URL}" \
 && grep -q 'GNU GENERAL PUBLIC LICENSE' /tmp/LICENSE \
 && grep -q 'Version 3, 29 June 2007'   /tmp/LICENSE \
 || { echo "ERROR: could not download a valid GPL-3.0 license from ${LICENSE_URL}" >&2; exit 1; }

# Stage everything the runtime image needs under /staging (mirrors "/").
#
# The whole scripts/ directory is copied recursively, whatever it contains:
#   - directories                                   -> 0755
#   - bash scripts (*.sh, or a "#!...bash|sh" shebang) -> 0755
#   - any other file                                -> 0644
# The downloaded GPL-3.0 LICENSE is copied last, so it always wins over a
# scripts/LICENSE file.
COPY scripts/ /tmp/scripts/
RUN install -D -m 0755 ./wrk                          /staging/usr/local/bin/wrk; \
    install -D -m 0644 ./LICENSE                      /staging/usr/share/licenses/wrk/LICENSE; \
    if [ -f ./NOTICE ]; then install -D -m 0644 ./NOTICE /staging/usr/share/licenses/wrk/NOTICE; fi; \
    install -d -m 0755 /staging/srv/scripts; \
    cp -R --no-preserve=mode,ownership /tmp/scripts/. /staging/srv/scripts/; \
    find /staging/srv/scripts -type d -exec chmod 0755 {} +; \
    find /staging/srv/scripts -type f -exec chmod 0644 {} +; \
    find /staging/srv/scripts -type f -print0 | while IFS= read -r -d '' f; do \
        if [[ "${f}" == *.sh ]] || head -n1 "${f}" | grep -Eq '^#!.*(/|[[:space:]])(ba)?sh([[:space:]]|$)'; then \
            chmod 0755 "${f}"; \
        fi; \
    done; \
    install -m 0644 /tmp/LICENSE                      /staging/srv/scripts/LICENSE; \
    echo "Staged /srv/scripts:"; find /staging/srv/scripts -printf '  %m %p\n' | sort -k2; \
    install -d -m 0775 /staging/srv/data; \
    install -d -m 0755 /staging/usr/share/doc/wrk; \
    { echo "repo=${WRK_REPO}"; \
      echo "ref=${WRK_REF}"; \
      echo "commit=$(git rev-parse HEAD)"; \
      echo "build_openssl=$(rpm -q openssl-libs)"; \
      echo "build_date=$(date -u +%Y-%m-%dT%H:%M:%SZ)"; } > /staging/usr/share/doc/wrk/BUILD-INFO

# -----------------------------------------------------------------------------
# Stage 2: runtime
# -----------------------------------------------------------------------------
FROM ${RUNTIME_IMAGE}

ARG MIN_OPENSSL_VERSION=3.5.0

LABEL org.opencontainers.image.title="wrk-pqc" \
      org.opencontainers.image.description="wrk built against system OpenSSL >= 3.5 on CentOS Stream 9 for TLS 1.3 PQC benchmarks" \
      org.opencontainers.image.base.name="quay.io/centos/centos:stream9-minimal" \
      org.opencontainers.image.licenses="GPL-3.0-or-later"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# OpenSSL runtime (libssl/libcrypto + CLI used by tls1.3-handshake-check.sh).
# coreutils provides "timeout", used by tls1.3-handshake-check.sh.
RUN microdnf -y install --setopt=install_weak_deps=0 --nodocs \
        openssl openssl-libs ca-certificates crypto-policies \
 && microdnf clean all \
 && rm -rf /var/cache/yum /var/cache/dnf \
 && command -v timeout >/dev/null

# Same OpenSSL guard as in the builder: the runtime libs must also be >= 3.5.
RUN v="$(rpm -q --qf '%{VERSION}' openssl-libs)"; \
    echo "Runtime openssl-libs version: ${v}"; \
    if [ "$(printf '%s\n%s\n' "${MIN_OPENSSL_VERSION}" "${v}" | sort -V | head -n1)" != "${MIN_OPENSSL_VERSION}" ]; then \
        echo "ERROR: runtime OpenSSL ${v} is older than ${MIN_OPENSSL_VERSION}" >&2; exit 1; \
    fi; \
    openssl list -kem-algorithms | grep -qi 'ML-KEM' || { echo "ERROR: ML-KEM not available" >&2; exit 1; }

# Copy the staged tree (wrk, scripts, OpenSSL configs, licenses, /srv/data).
COPY --from=builder /staging/ /

# Smoke test: the binary must load (wrk -v prints the version, then usage, exit 1).
RUN /usr/local/bin/wrk -v 2>&1 | head -n1 | grep -q '^wrk ' \
 && cat /usr/share/doc/wrk/BUILD-INFO

# The default command must exist in scripts/ and be executable.
RUN test -x /srv/scripts/tls1.3-handshake-check.sh \
 || { echo "ERROR: scripts/tls1.3-handshake-check.sh is missing or not executable" >&2; exit 1; }

# Test parameters (set them with "podman run -e ...").
#   SERVER_IP, SERVER_PORT, SCENARIO : required by tls1.3-handshake-check.sh
#   OPENSSL_CONF_PATH                : OpenSSL client config (empty = system default)
ENV PATH="/srv/scripts:${PATH}" \
    SERVER_IP="" \
    SERVER_PORT="" \
    SCENARIO="" \
    OPENSSL_CONF_PATH=""

WORKDIR /srv/scripts
VOLUME ["/srv/data"]

USER 1001

# Default command when no script/command is given on "podman run":
# the TLS 1.3 handshake check. Any command passed to "podman run" replaces it.
CMD ["tls1.3-handshake-check.sh"]
