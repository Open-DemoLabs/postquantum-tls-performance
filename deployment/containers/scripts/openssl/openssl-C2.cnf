# =============================================================================
# wrk client OpenSSL configuration - Scenario C2
# Key exchange: NIST P-521 | Server certificate: ECDSA + SHA-512
# Usage: podman run ... -e WRK_SCENARIO=C2 ...   (or -e OPENSSL_CONF=/srv/data/openssl-C2.cnf)
#
# This file deliberately does NOT include the system crypto-policies, so the
# client offers exactly what is listed below (deterministic benchmarks).
# =============================================================================

# Make configuration errors fatal instead of silently ignored
# (e.g. a misspelled group name would otherwise fall back to defaults).
config_diagnostics = 1

openssl_conf = openssl_init

[openssl_init]
ssl_conf = ssl_module

[ssl_module]
system_default = tls_client

[tls_client]
MinProtocol  = TLSv1.3
MaxProtocol  = TLSv1.3
Ciphersuites = TLS_AES_256_GCM_SHA384
Groups       = secp521r1

# Optional: restrict the signature algorithms offered by the client so the
# handshake FAILS unless the server presents the expected certificate type.
# Check the names supported by this build with:
#   podman run --rm localhost/wrk-pqc:latest openssl list -signature-algorithms
#SignatureAlgorithms = ecdsa_secp521r1_sha512
